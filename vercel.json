{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    { "src": "/api/login\\.php", "dest": "/api/login.php" },
    { "src": "/api/auth\\.php", "dest": "/api/auth.php" },
    { "src": "/api/admin\\.php", "dest": "/api/admin.php" },
    { "src": "/api/logout\\.php", "dest": "/api/logout.php" },
    { "src": "/login", "dest": "/api/login.php" },
    { "src": "/admin", "dest": "/api/admin.php" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
